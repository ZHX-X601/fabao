# ================== 法宝后端环境变量示例 ==================
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 排除，不会提交）

# ---------- 应用配置 ----------
# 是否开启调试模式（会打印 SQL 语句）
DEBUG=true

# ---------- 数据库配置（MySQL）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=fabao
# 数据库连接地址覆盖项（可选）：设置后忽略上方 DB_* 配置，例如测试时用 sqlite
# DATABASE_URL_OVERRIDE=sqlite:///./fabao_dev.db

# ---------- JWT 认证配置 ----------
# 生产环境务必换成足够长的随机字符串（如 openssl rand -hex 32 的输出）
JWT_SECRET_KEY=fabao-please-change-this-secret-key
JWT_ALGORITHM=HS256
# token 有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440

# ---------- 文件与建表 ----------
# 合同上传文件保存目录（相对 backend 目录）
UPLOAD_DIR=uploads
# 启动时自动建表（开发环境便捷开关；生产建议 false，统一用 alembic 迁移）
AUTO_CREATE_TABLES=true

# ---------- 跨域配置 ----------
# 允许的前端来源，多个用 JSON 数组格式书写
# 部署到 CF Pages 等线上前端时，把站点域名加进来，例如：
# CORS_ORIGINS=["http://localhost:5173","https://fabao-xxx.pages.dev"]
CORS_ORIGINS=["http://localhost:5173","https://fabao.blog-x.cc.cd"]

# ---------- FastGPT 配置（留空则使用本地模拟回复）----------
FASTGPT_BASE_URL=http://localhost:3000/api
FASTGPT_API_KEY=
# AI 法律咨询应用 ID
FASTGPT_APP_ID=
# 文书生成应用 ID
FASTGPT_DOC_APP_ID=
# 合同审查应用 ID
FASTGPT_CONTRACT_APP_ID=
